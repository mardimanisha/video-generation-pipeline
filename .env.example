# Copy this file to .env and fill in the values. Never commit .env.

# Inworld TTS + voice cloning (https://platform.inworld.ai -> API Keys).
# Paste the Base64 "Basic" credential exactly as the portal shows it.
INWORLD_API_KEY=

# Optional: use an existing Inworld voice instead of cloning from voice_sample.wav.
# Overrides the voice_id stored in presenters/<name>/voice.json.
INWORLD_VOICE_ID=

# Gemini API key with Veo access (https://aistudio.google.com/apikey).
# Only needed for --video-provider gemini. Not needed for --manual-video.
GEMINI_API_KEY=
